{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "lib": ["es2024", "DOM"],
        "types": ["node"],
        "paths": {
            "@takt/ui": ["./packages/ui/src/index.ts"],
            "@takt/ui/components": ["./packages/ui/src/components/index.ts"],
            "@takt/ui/jsx-runtime": ["./packages/ui/src/jsx-runtime.ts"],
            "@takt/ui/jsx-dev-runtime": [
                "./packages/ui/src/jsx-dev-runtime.ts"
            ],
            "@takt/templates": ["./packages/templates/src/index.ts"],
            "@takt/renderer": ["./packages/renderer/src/index.ts"],
            "@takt/renderer/exporters": [
                "./packages/renderer/src/exporters/index.ts"
            ]
        },
        "jsx": "react-jsx",
        "jsxImportSource": "@takt/ui",
        "noEmit": true,
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "sourceMap": false,
        "incremental": false,
        "skipLibCheck": true
    },
    "include": [
        "apps/*/src/**/*.ts",
        "apps/*/src/**/*.tsx",
        "packages/*/src/**/*.ts",
        "packages/*/src/**/*.tsx",
        "tests/**/*.ts"
    ]
}
