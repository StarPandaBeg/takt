{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "paths": {
            "@takt/ui": ["./packages/ui/src/index.ts"],
            "@takt/ui/components": ["./packages/ui/src/components/index.ts"],
            "@takt/ui/jsx-runtime": ["./packages/ui/src/jsx-runtime.ts"],
            "@takt/ui/jsx-dev-runtime": ["./packages/ui/src/jsx-dev-runtime.ts"]
        },
        "jsx": "react-jsx",
        "jsxImportSource": "@takt/ui",
        "noEmit": true,
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "sourceMap": false,
        "incremental": false
    },
    "include": ["packages/**/*.ts", "packages/**/*.tsx"]
}
