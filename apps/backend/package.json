{
    "name": "@takt/backend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Backend application",
    "main": "./dist/main.js",
    "types": "./dist/main.d.ts",
    "scripts": {
        "build": "tsc --build --force",
        "build:incremental": "tsc --build",
        "build:clean": "tsc --build --clean",
        "typecheck": "tsc --build --force",
        "start": "node --enable-source-maps ./dist/main.js",
        "dev": "node --watch --enable-source-maps ./dist/main.js"
    },
    "author": "StarPanda",
    "license": "MIT",
    "dependencies": {
        "@fastify/cors": "^11.3.1",
        "@libsql/client": "^0.18.0",
        "@modelcontextprotocol/node": "^2.1.2",
        "@modelcontextprotocol/server": "^2.4.0",
        "@napi-rs/canvas": "^1.0.13",
        "@takt/renderer": "^1.0.0",
        "@takt/templates": "^1.0.0",
        "@takt/ui": "^1.0.0",
        "dotenv": "^18.0.9",
        "drizzle-orm": "^1.0.0-rc.5",
        "fastify": "^5.12.7",
        "luxon": "^3.7.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/luxon": "^3.7.6",
        "drizzle-kit": "^1.0.0-rc.5"
    },
    "imports": {
        "#src/*": "./dist/*"
    }
}
