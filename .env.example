DB_FILE_NAME=file:./takt.db
HOST=0.0.0.0
PORT=3000
AUTH_TOKEN=replace-with-a-long-random-token
# Optional device-only token for /api/diagnostics/*. Defaults to AUTH_TOKEN.
TAKT_DIAGNOSTICS_TOKEN=replace-with-a-different-long-random-token
# Directory for binary core dumps (default: ./data/diagnostics/coredumps).
TAKT_COREDUMP_DIR=./data/diagnostics/coredumps
VITE_AUTH_TOKEN=replace-with-a-long-random-token
VITE_BACKEND_URL=
TAKT_IMAGE=takt-backend:latest
TAKT_PORT=3011
